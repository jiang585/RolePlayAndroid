<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:foregroundGravity="center_horizontal"
    android:paddingTop="@dimen/space_m"
    android:paddingBottom="@dimen/space_m"
    android:paddingHorizontal="@dimen/space_m">

    <TextView
        android:id="@+id/tv_narration_content"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:background="@drawable/bg_narration_chip"
        android:gravity="center"
        android:maxWidth="340dp"
        android:paddingHorizontal="16dp"
        android:paddingVertical="10dp"
        android:lineSpacingExtra="3dp"
        android:textColor="@color/s9_narration_text"
        android:textSize="@dimen/s9_narration_size" />
</FrameLayout>