<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_page_warm"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/screen_margin"
        android:paddingBottom="48dp">

        <!-- AI 智能扩写世界观 -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_ai_enhance_world"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/world_ai_enhance"
            style="@style/Widget.RolePlayChat.Button.Secondary"
            app:icon="@drawable/ic_auto_awesome"
            app:iconGravity="textStart"
            app:iconPadding="8dp" />

        <ProgressBar
            android:id="@+id/progress_world_ai"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_s"
            android:indeterminate="true"
            android:visibility="gone" />

        <TextView
            android:id="@+id/text_world_ai_progress"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_xs"
            android:gravity="center"
            android:textColor="@color/text_secondary"
            android:textSize="@dimen/text_caption"
            android:visibility="gone" />

        <!-- 卡片1：时空与宏观背景 -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_l"
            style="@style/Widget.RolePlayChat.Card">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/space_l">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="时空与地理环境"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:textColor="@color/text_primary" />

                <EditText
                    android:id="@+id/input_world_era"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_m"
                    android:background="@drawable/bg_input_field"
                    android:hint="@string/world_era_hint"
                    android:textColorHint="@color/text_disabled"
                    android:textColor="@color/text_primary"
                    android:paddingHorizontal="14dp"
                    android:paddingVertical="10dp"
                    android:textSize="@dimen/text_body"
                    android:inputType="text"
                    android:maxLines="2" />

                <EditText
                    android:id="@+id/input_world_location"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_s"
                    android:background="@drawable/bg_input_field"
                    android:hint="@string/world_location_hint"
                    android:textColorHint="@color/text_disabled"
                    android:textColor="@color/text_primary"
                    android:paddingHorizontal="14dp"
                    android:paddingVertical="10dp"
                    android:textSize="@dimen/text_body"
                    android:inputType="text"
                    android:maxLines="2" />

                <EditText
                    android:id="@+id/input_world_background"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_s"
                    android:background="@drawable/bg_input_field"
                    android:hint="@string/world_background"
                    android:textColorHint="@color/text_disabled"
                    android:textColor="@color/text_primary"
                    android:paddingHorizontal="14dp"
                    android:paddingVertical="10dp"
                    android:textSize="@dimen/text_body"
                    android:inputType="textMultiLine"
                    android:minLines="5" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- 卡片2：规则与阵营 -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_l"
            style="@style/Widget.RolePlayChat.Card">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/space_l">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="规则与各方势力"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:textColor="@color/text_primary" />

                <EditText
                    android:id="@+id/input_world_factions"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_m"
                    android:background="@drawable/bg_input_field"
                    android:hint="@string/world_factions"
                    android:textColorHint="@color/text_disabled"
                    android:textColor="@color/text_primary"
                    android:paddingHorizontal="14dp"
                    android:paddingVertical="10dp"
                    android:textSize="@dimen/text_body"
                    android:inputType="textMultiLine"
                    android:minLines="3" />

                <EditText
                    android:id="@+id/input_world_rules"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_s"
                    android:background="@drawable/bg_input_field"
                    android:hint="@string/world_rules"
                    android:textColorHint="@color/text_disabled"
                    android:textColor="@color/text_primary"
                    android:paddingHorizontal="14dp"
                    android:paddingVertical="10dp"
                    android:textSize="@dimen/text_body"
                    android:inputType="textMultiLine"
                    android:minLines="3" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- 卡片3：剧情引子与元数据 -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_l"
            style="@style/Widget.RolePlayChat.Card">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/space_l">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="开篇引子与标签"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:textColor="@color/text_primary" />

                <EditText
                    android:id="@+id/input_world_story_hook"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_m"
                    android:background="@drawable/bg_input_field"
                    android:hint="@string/world_story_hook"
                    android:textColorHint="@color/text_disabled"
                    android:textColor="@color/text_primary"
                    android:paddingHorizontal="14dp"
                    android:paddingVertical="10dp"
                    android:textSize="@dimen/text_body"
                    android:inputType="textMultiLine"
                    android:minLines="3" />

                <EditText
                    android:id="@+id/input_world_tags"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_s"
                    android:background="@drawable/bg_input_field"
                    android:hint="@string/world_tags"
                    android:textColorHint="@color/text_disabled"
                    android:textColor="@color/text_primary"
                    android:paddingHorizontal="14dp"
                    android:paddingVertical="10dp"
                    android:textSize="@dimen/text_body"
                    android:inputType="text"
                    android:maxLines="2" />

                <EditText
                    android:id="@+id/input_world_version_note"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_s"
                    android:background="@drawable/bg_input_field"
                    android:hint="@string/world_version_note"
                    android:textColorHint="@color/text_disabled"
                    android:textColor="@color/text_primary"
                    android:paddingHorizontal="14dp"
                    android:paddingVertical="10dp"
                    android:textSize="@dimen/text_body"
                    android:inputType="text"
                    android:maxLines="2" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_save_world"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginTop="@dimen/space_xl"
            android:text="@string/action_save"
            style="@style/Widget.RolePlayChat.Button" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_chat_rules"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_m"
            android:text="@string/chat_rules"
            style="@style/Widget.RolePlayChat.Button.Quiet" />
    </LinearLayout>
</ScrollView>