<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_page_warm"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/screen_margin"
        android:paddingBottom="48dp">

        <!-- 角色头像区 -->
        <FrameLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="@dimen/space_s">

            <ImageView
                android:id="@+id/iv_edit_avatar"
                android:layout_width="76dp"
                android:layout_height="76dp"
                android:background="@drawable/bg_avatar_circle"
                android:contentDescription="@string/character_avatar_change"
                android:padding="2dp"
                android:src="@drawable/ic_avatar_placeholder" />
        </FrameLayout>

        <!-- AI 智能扩写增强 -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_ai_enhance_character"
            style="@style/Widget.RolePlayChat.Button.Secondary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_l"
            android:text="@string/character_ai_enhance"
            app:icon="@drawable/ic_auto_awesome"
            app:iconGravity="textStart"
            app:iconPadding="8dp" />

        <ProgressBar
            android:id="@+id/progress_character_ai"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_s"
            android:indeterminate="true"
            android:visibility="gone" />

        <TextView
            android:id="@+id/text_character_ai_progress"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_xs"
            android:gravity="center"
            android:textColor="@color/text_secondary"
            android:textSize="@dimen/text_caption"
            android:visibility="gone" />

        <!-- 卡片1：基础档案 -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_l"
            style="@style/Widget.RolePlayChat.Card">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/space_l">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="基本信息"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:textColor="@color/text_primary" />

                <EditText
                    android:id="@+id/input_char_name"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_m"
                    android:background="@drawable/bg_input_field"
                    android:hint="@string/character_name_hint"
                    android:textColorHint="@color/text_disabled"
                    android:textColor="@color/text_primary"
                    android:paddingHorizontal="14dp"
                    android:paddingVertical="10dp"
                    android:textSize="@dimen/text_body"
                    android:maxLength="80" />

                <EditText
                    android:id="@+id/input_char_aliases"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_s"
                    android:background="@drawable/bg_input_field"
                    android:hint="@string/character_aliases"
                    android:textColorHint="@color/text_disabled"
                    android:textColor="@color/text_primary"
                    android:paddingHorizontal="14dp"
                    android:paddingVertical="10dp"
                    android:textSize="@dimen/text_body"
                    android:inputType="text"
                    android:maxLines="2" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_s"
                    android:orientation="horizontal">

                    <EditText
                        android:id="@+id/input_char_gender"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:background="@drawable/bg_input_field"
                        android:hint="@string/character_gender"
                        android:textColorHint="@color/text_disabled"
                        android:textColor="@color/text_primary"
                        android:paddingHorizontal="14dp"
                        android:paddingVertical="10dp"
                        android:textSize="@dimen/text_body" />

                    <EditText
                        android:id="@+id/input_char_age"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="@dimen/space_s"
                        android:background="@drawable/bg_input_field"
                        android:hint="@string/character_age"
                        android:textColorHint="@color/text_disabled"
                        android:textColor="@color/text_primary"
                        android:paddingHorizontal="14dp"
                        android:paddingVertical="10dp"
                        android:textSize="@dimen/text_body" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- 卡片2：性格与背景 -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_l"
            style="@style/Widget.RolePlayChat.Card">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/space_l">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="性格与人物经历"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:textColor="@color/text_primary" />

                <EditText
                    android:id="@+id/input_char_personality"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_m"
                    android:background="@drawable/bg_input_field"
                    android:hint="@string/character_personality"
                    android:textColorHint="@color/text_disabled"
                    android:textColor="@color/text_primary"
                    android:paddingHorizontal="14dp"
                    android:paddingVertical="10dp"
                    android:textSize="@dimen/text_body"
                    android:inputType="textMultiLine"
                    android:minLines="3" />

                <EditText
                    android:id="@+id/input_char_backstory"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_s"
                    android:background="@drawable/bg_input_field"
                    android:hint="@string/character_backstory"
                    android:textColorHint="@color/text_disabled"
                    android:textColor="@color/text_primary"
                    android:paddingHorizontal="14dp"
                    android:paddingVertical="10dp"
                    android:textSize="@dimen/text_body"
                    android:inputType="textMultiLine"
                    android:minLines="4" />

                <EditText
                    android:id="@+id/input_char_strengths"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_s"
                    android:background="@drawable/bg_input_field"
                    android:hint="@string/character_strengths"
                    android:textColorHint="@color/text_disabled"
                    android:textColor="@color/text_primary"
                    android:paddingHorizontal="14dp"
                    android:paddingVertical="10dp"
                    android:textSize="@dimen/text_body"
                    android:inputType="textMultiLine"
                    android:minLines="2" />

                <EditText
                    android:id="@+id/input_char_flaws"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_s"
                    android:background="@drawable/bg_input_field"
                    android:hint="@string/character_flaws"
                    android:textColorHint="@color/text_disabled"
                    android:textColor="@color/text_primary"
                    android:paddingHorizontal="14dp"
                    android:paddingVertical="10dp"
                    android:textSize="@dimen/text_body"
                    android:inputType="textMultiLine"
                    android:minLines="2" />

                <EditText
                    android:id="@+id/input_char_relationships"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_s"
                    android:background="@drawable/bg_input_field"
                    android:hint="@string/character_relationships"
                    android:textColorHint="@color/text_disabled"
                    android:textColor="@color/text_primary"
                    android:paddingHorizontal="14dp"
                    android:paddingVertical="10dp"
                    android:textSize="@dimen/text_body"
                    android:inputType="textMultiLine"
                    android:minLines="2" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- 卡片3：对话习惯与台词 -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_l"
            style="@style/Widget.RolePlayChat.Card">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/space_l">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="台词与言行风格"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:textColor="@color/text_primary" />

                <EditText
                    android:id="@+id/input_char_speaking_style"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_m"
                    android:background="@drawable/bg_input_field"
                    android:hint="@string/character_speaking_style"
                    android:textColorHint="@color/text_disabled"
                    android:textColor="@color/text_primary"
                    android:paddingHorizontal="14dp"
                    android:paddingVertical="10dp"
                    android:textSize="@dimen/text_body"
                    android:inputType="textMultiLine"
                    android:minLines="2" />

                <EditText
                    android:id="@+id/input_char_catchphrases"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_s"
                    android:background="@drawable/bg_input_field"
                    android:hint="@string/character_catchphrases"
                    android:textColorHint="@color/text_disabled"
                    android:textColor="@color/text_primary"
                    android:paddingHorizontal="14dp"
                    android:paddingVertical="10dp"
                    android:textSize="@dimen/text_body"
                    android:inputType="textMultiLine"
                    android:minLines="2" />

                <EditText
                    android:id="@+id/input_char_sample_lines"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_s"
                    android:background="@drawable/bg_input_field"
                    android:hint="@string/character_sample_lines"
                    android:textColorHint="@color/text_disabled"
                    android:textColor="@color/text_primary"
                    android:paddingHorizontal="14dp"
                    android:paddingVertical="10dp"
                    android:textSize="@dimen/text_body"
                    android:inputType="textMultiLine"
                    android:minLines="2" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- 卡片4：高级设定 -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_l"
            style="@style/Widget.RolePlayChat.Card">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/space_l">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="系统提示词与隐藏设定"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:textColor="@color/text_primary" />

                <EditText
                    android:id="@+id/input_char_system_prompt"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_m"
                    android:background="@drawable/bg_input_field"
                    android:hint="@string/character_system_prompt"
                    android:textColorHint="@color/text_disabled"
                    android:textColor="@color/text_primary"
                    android:paddingHorizontal="14dp"
                    android:paddingVertical="10dp"
                    android:textSize="@dimen/text_body"
                    android:inputType="textMultiLine"
                    android:minLines="2" />

                <EditText
                    android:id="@+id/input_char_hidden_setting"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_s"
                    android:background="@drawable/bg_input_field"
                    android:hint="@string/character_hidden_setting"
                    android:textColorHint="@color/text_disabled"
                    android:textColor="@color/text_primary"
                    android:paddingHorizontal="14dp"
                    android:paddingVertical="10dp"
                    android:textSize="@dimen/text_body"
                    android:inputType="textMultiLine"
                    android:minLines="2" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_save_character"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginTop="@dimen/space_xl"
            android:text="@string/action_save"
            style="@style/Widget.RolePlayChat.Button" />
    </LinearLayout>
</ScrollView>