<?xml version="1.0" encoding="utf-8"?>
<!--
  备份策略：默认排除所有备份（allowBackup=false）。
  仅保留说明性内容：即使系统备份开启也排除敏感目录。
-->
<full-backup-content>
    <exclude domain="root" path="." />
    <exclude domain="database" path="." />
    <exclude domain="sharedpref" path="." />
    <exclude domain="file" path="." />
</full-backup-content>
