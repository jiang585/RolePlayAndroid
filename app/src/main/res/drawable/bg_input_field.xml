<?xml version="1.0" encoding="utf-8"?>
<!-- 底部输入框：圆角22dp、柔和底色、聚焦时品牌墨绿描边 -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/brand_surface" />
            <stroke
                android:width="1.5dp"
                android:color="@color/s9_primary" />
            <corners android:radius="@dimen/s9_input_corner" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/s9_input_bg" />
            <stroke
                android:width="1dp"
                android:color="@color/brand_outline" />
            <corners android:radius="@dimen/s9_input_corner" />
        </shape>
    </item>
</selector>