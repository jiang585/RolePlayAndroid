<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Widget.RolePlayChat.Card" parent="Widget.Material3.CardView.Elevated">
        <item name="cardCornerRadius">@dimen/card_corner</item>
        <item name="cardElevation">0.5dp</item>
        <item name="strokeColor">@color/brand_outline</item>
        <item name="strokeWidth">1dp</item>
        <item name="cardBackgroundColor">@color/brand_surface</item>
        <item name="android:stateListAnimator">@null</item>
    </style>

    <style name="Widget.RolePlayChat.Card.Parchment" parent="Widget.RolePlayChat.Card">
        <item name="cardBackgroundColor">@color/brand_surface_variant</item>
        <item name="strokeColor">@color/brand_outline_light</item>
        <item name="cardElevation">0dp</item>
    </style>

    <style name="Widget.RolePlayChat.Button" parent="Widget.Material3.Button">
        <item name="cornerRadius">14dp</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textStyle">bold</item>
        <item name="backgroundTint">@color/brand_primary</item>
        <item name="android:textColor">@color/brand_on_primary</item>
        <item name="iconTint">@color/brand_on_primary</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
    </style>

    <style name="Widget.RolePlayChat.Button.Secondary" parent="Widget.Material3.Button.TonalButton">
        <item name="cornerRadius">14dp</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textStyle">bold</item>
        <item name="backgroundTint">@color/brand_primary_container</item>
        <item name="android:textColor">@color/brand_primary</item>
        <item name="iconTint">@color/brand_primary</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
    </style>

    <style name="Widget.RolePlayChat.Button.Quiet" parent="Widget.Material3.Button.OutlinedButton">
        <item name="cornerRadius">14dp</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:textSize">15sp</item>
        <item name="strokeColor">@color/brand_outline</item>
        <item name="strokeWidth">1dp</item>
        <item name="android:textColor">@color/brand_primary</item>
        <item name="iconTint">@color/brand_primary</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
    </style>

    <style name="TextAppearance.RolePlayChat.Caption" parent="TextAppearance.Material3.BodySmall">
        <item name="android:textColor">@color/text_secondary</item>
        <item name="android:textSize">@dimen/text_caption</item>
        <item name="android:lineSpacingExtra">2dp</item>
    </style>

    <style name="TextAppearance.RolePlayChat.Title" parent="TextAppearance.Material3.TitleMedium">
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textSize">@dimen/text_title</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="Widget.RolePlayChat.TextInputLayout" parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="boxCornerRadiusTopStart">12dp</item>
        <item name="boxCornerRadiusTopEnd">12dp</item>
        <item name="boxCornerRadiusBottomStart">12dp</item>
        <item name="boxCornerRadiusBottomEnd">12dp</item>
        <item name="boxStrokeColor">@color/brand_primary</item>
        <item name="hintTextColor">@color/brand_primary</item>
    </style>
</resources>